doc <- bl(doc, "CDISC Analysis Results Standard (ARS) — https://www.cdisc.org/standards/foundational/ars")
doc <- bl(doc, "pharmaverse — https://pharmaverse.org")
doc <- bl(doc, "ellmer: Talk to LLMs from R — https://ellmer.tidyverse.org")
doc <- bl(doc, "FDA Study Data Technical Conformance Guide (2025) — https://www.fda.gov/media/82663/download")
doc <- bl(doc, "PHUSE Working Group: Automation in Clinical Trial Reporting (2024)")
