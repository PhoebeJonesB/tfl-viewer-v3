# Define some sample reasons for discontinuation
reasons <- c(
"Adverse Event",
"Withdrawal by Subject",
"Lost to Follow-up",
"Technical problem",
"Study terminated by sponsor"
)
adsl_with_reason <- dm1 %>%
mutate(
# Randomly assign a reason or NA (say 70% chance of having a reason)
REAS = ifelse(
EOSSTT == "DISCONTINUED",                   # 70% chance to have a reason
sample(reasons, n(), replace = TRUE),  # randomly pick one reason
NA_character_                      # else NA (no discontinuation)
)
)
#Create Total row & filter subjects in saftey population
adsl1 <- adsl_with_reason %>%
mutate(ACTARMCD = "Total") %>%
union_all(adsl_with_reason)%>%
filter(SAFFL == "Y")
#Create Total row & filter subjects in saftey population
adsl1 <- adsl_with_reason %>%
mutate(ACTARMCD = "Total") %>%
union_all(adsl_with_reason)%>%
filter(SAFFL == "Y")
adsl_with_reason <- dm1 %>%
mutate(
# Randomly assign a reason or NA (say 70% chance of having a reason)
REAS = ifelse(
EOSSTT == "DISCONTINUED",                   # 70% chance to have a reason
sample(reasons, n(), replace = TRUE),  # randomly pick one reason
NA_character_                      # else NA (no discontinuation)
)
)
adsl_with_reason <- dm %>%
mutate(
# Randomly assign a reason or NA (say 70% chance of having a reason)
REAS = ifelse(
EOSSTT == "DISCONTINUED",                   # 70% chance to have a reason
sample(reasons, n(), replace = TRUE),  # randomly pick one reason
NA_character_                      # else NA (no discontinuation)
)
)
adsl_with_reason <- adsl %>%
mutate(
# Randomly assign a reason or NA (say 70% chance of having a reason)
REAS = ifelse(
EOSSTT == "DISCONTINUED",                   # 70% chance to have a reason
sample(reasons, n(), replace = TRUE),  # randomly pick one reason
NA_character_                      # else NA (no discontinuation)
)
)
#Create Total row & filter subjects in saftey population
adsl1 <- adsl_with_reason %>%
mutate(ACTARMCD = "Total") %>%
union_all(adsl_with_reason)%>%
filter(SAFFL == "Y")
#Get bigN count for each Treatment Group
bigN <- adsl1 %>%
group_by(ACTARMCD) %>%
summarise(N = n_distinct(USUBJID)) %>%
mutate(BN = paste(ACTARMCD,"(N=",N,")"))
# Completed/Discontinued Category
adsl2 <- adsl1 %>% filter(EOSSTT != "") %>%
mutate(ORD1 = if_else(EOSSTT == "COMPLETED", 1.1, 1.2)) %>%
select(USUBJID, EOSSTT, ACTARM, ACTARMCD,ORD1) %>% unique() %>%
group_by(ACTARMCD,EOSSTT,ORD1) %>% count() %>% ungroup() %>%
left_join(bigN, by=c("ACTARMCD"))
adsl3 <- adsl2 %>% mutate(per = paste0(n, " (", round((n / N) * 100, digits = 2), "%)")) %>%
arrange()
fin_1 <- adsl3 %>% pivot_wider(id_cols = c("EOSSTT","ORD1"), names_from = "ACTARMCD", values_from = "per") %>%
mutate(
EOSSTT = str_to_title(EOSSTT),                # convert EOSSTT to proper case
TXT = paste0("Study ", EOSSTT)          # create TXT with proper-cased EOSSTT
)
adsldis <- adsl1 %>% filter(EOSSTT == "DISCONTINUED") %>%
#mutate(ORD1 = if_else(EOSSTT == "COMPLETED", 1.1, 1.2)) %>%
select(USUBJID, EOSSTT, REAS, ACTARM, ACTARMCD) %>% unique() %>%
group_by(ACTARMCD,EOSSTT,REAS) %>% count() %>% ungroup() %>%
left_join(bigN, by=c("ACTARMCD"))
adsldis1 <- adsldis %>% mutate(per = paste0(n, " (", round((n / N) * 100, digits = 2), "%)")) %>%
arrange()
fin_2 <- adsldis1 %>% pivot_wider(id_cols = c("REAS"), names_from = "ACTARMCD", values_from = "per") %>%
mutate(TXT = paste0("  ", REAS))
# Setting the fin datasets
fin <- bind_rows(fin_1, fin_2)
# Creating Dummy
dummy <- tribble(
~TXT, ~ORD1,
"Primary reason for disontinuation", 1.3
)
# Setting fin and Dummy
final <- bind_rows(fin, dummy) %>% arrange(ORD1)
final_with_spaces <- final %>%
group_by(ORD1) %>%
do(bind_rows(., tibble(TXT = "", ORD1 = NA, Pbo = "", Xan_Hi = "", Xan_Lo = "",Total="", REAS=""))) %>%
ungroup() %>% select(-ORD1,-EOSSTT)
View(final_with_spaces)
View(final_with_spaces)
View(adsldis1)
View(adsldis1)
View(adsl)
View(adsl)
