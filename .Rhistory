# ── Helper shortcuts ──────────────────────────────────────────────────────────
h1  <- function(doc, txt) body_add_par(doc, txt, style = "heading 1")
h2  <- function(doc, txt) body_add_par(doc, txt, style = "heading 2")
h3  <- function(doc, txt) body_add_par(doc, txt, style = "heading 3")
p   <- function(doc, txt) body_add_par(doc, txt, style = "Normal")
bl  <- function(doc, txt) body_add_par(doc, txt, style = "List Bullet")
nb  <- function(doc)      body_add_par(doc, "",  style = "Normal")
# ── TITLE ─────────────────────────────────────────────────────────────────────
doc <- h1(doc, "Framework of Agentic AI in Clinical Trials")
doc <- h2(doc, "Code Integration within SAS and R/Python — Detailed Breakdown")
doc <- p(doc, paste0("Prepared: ", format(Sys.Date(), "%B %d, %Y")))
doc <- p(doc, "Project: agentic-ai-clinical-trials")
doc <- nb(doc)
# ── PART 1 ────────────────────────────────────────────────────────────────────
doc <- h1(doc, "PART 1 — What Was Built, Step by Step")
doc <- nb(doc)
# Step 0
doc <- h2(doc, "Step 0 · Project Scaffolding")
doc <- p(doc, "Before writing any analysis code, a clean, self-contained R project was created at:")
doc <- p(doc, "C:\\Users\\atienop\\Documents\\agentic-ai-clinical-trials\\")
doc <- nb(doc)
doc <- p(doc, "This included:")
doc <- bl(doc, "An .Rproj file so the project opens correctly in RStudio with its own working directory, history, and settings — separate from the TFL Viewer project.")
doc <- bl(doc, "A directory structure separating concerns cleanly: R/ for agent scripts, sas/ for SAS code, abstract/ for the conference submission, and outputs/ars/ for generated CDISC JSON.")
doc <- bl(doc, "A README.md that documents the architecture, quick-start instructions, technology stack, and how to connect to the TFL Viewer v3.")
doc <- nb(doc)
doc <- p(doc, "This separation matters because the agentic framework is a standalone reusable template — it is not embedded inside the TFL Viewer, but it feeds into it.")
doc <- nb(doc)
# Step 1
doc <- h2(doc, "Step 1 · Synthetic CDISC ADaM Data (R/00_data_gen.R)")
doc <- p(doc, "The first R file generates realistic, fully synthetic clinical trial datasets following CDISC ADaM conventions:")
doc <- bl(doc, "ADSL (200 subjects): Subject-level dataset with treatment arms (Placebo, Active 10mg, Active 20mg), demographics (AGE, SEX, RACE), population flags (ENRLFL, ITTFL, SAFFL, PPROTFL), and disposition reason (DCSREAS).")
doc <- bl(doc, "ADAE (463 records): Adverse event dataset with System Organ Class (AESOC), Preferred Term (AEDECOD), severity, relatedness, and seriousness. Event rates are intentionally higher in the Active 20mg arm to simulate a real dose-response signal.")
doc <- bl(doc, "ADLB (800 records): Longitudinal laboratory data — ALT values across 4 visits per subject.")
doc <- bl(doc, "ADTTE (200 records): Time-to-event data (Overall Survival) with Weibull-distributed survival times — longer in active arms to simulate a treatment benefit.")
doc <- nb(doc)
doc <- p(doc, "This is the same generator used in TFL Viewer v3 (tfl-viewer-v3/R/data_gen.R), so outputs are directly comparable between the two projects.")
doc <- nb(doc)
# Step 2
doc <- h2(doc, "Step 2 · Agent 1 — SAP Parsing Agent (R/01_sap_agent.R)")
doc <- p(doc, "What it does: Takes a Statistical Analysis Plan (SAP) as input and converts it into a structured list of analysis specifications — essentially a task queue that every downstream agent acts on.")
doc <- nb(doc)
doc <- p(doc, "For each analysis, the agent produces a specification containing:")
doc <- bl(doc, "id — unique TFL identifier (e.g., t14_1_1)")
doc <- bl(doc, "title — full display title")
doc <- bl(doc, "population — human-readable population name (e.g., Safety Population)")
doc <- bl(doc, "population_flag — CDISC ADaM flag column (e.g., SAFFL)")
doc <- bl(doc, "endpoint — what is being measured")
doc <- bl(doc, "dataset — which ADaM dataset to use")
doc <- bl(doc, "method — statistical method (e.g., Frequency / Percentage)")
doc <- bl(doc, "display_type — Table / Figure / Listing")
doc <- bl(doc, "grouping_vars — treatment arm variable(s) for columns")
doc <- bl(doc, "output_footnotes — array of footnote strings")
doc <- nb(doc)
doc <- p(doc, "In the demo, four analyses are specified: t14_1_1 (Subject Disposition), t14_1_2 (Demographics & Baseline), t14_3_1 (Treatment-Emergent AEs), and f14_2_1 (Kaplan-Meier OS).")
doc <- nb(doc)
doc <- p(doc, "The function sap_agent_parse() has a use_llm = TRUE/FALSE toggle — in demo mode it uses hard-coded specs; in production it calls the LLM (explained in Part 2).")
doc <- nb(doc)
# Step 3
doc <- h2(doc, "Step 3 · Agent 2 — Code Generation Agent (R/02_code_agent.R)")
doc <- p(doc, "What it does: Takes each analysis specification and generates executable code in one or more target languages — R, SAS, and Python.")
doc <- nb(doc)
doc <- h3(doc, "R Code (tidyverse style)")
doc <- bl(doc, "Uses dplyr pipelines with filter(), group_by(), summarise(), mutate()")
doc <- bl(doc, "KM figure uses base R survival::survfit() and plot()")
doc <- bl(doc, "Population flags, grouping variables, and footnotes are injected from the spec using {glue} templating")
doc <- nb(doc)
doc <- h3(doc, "SAS Code (PROC-based)")
doc <- bl(doc, "PROC FREQ for categorical counts and cross-tabs")
doc <- bl(doc, "PROC MEANS for continuous summary statistics (n, mean, SD, median, min, max)")
doc <- bl(doc, "PROC REPORT for formatted tabular display")
doc <- bl(doc, "PROC LIFETEST for Kaplan-Meier survival curves with the log-rank test")
doc <- bl(doc, "SAS dataset names are uppercased per convention (WORK.ADSL, WORK.ADAE)")
doc <- nb(doc)
doc <- h3(doc, "Python Code (pandas / lifelines)")
doc <- bl(doc, "pandas groupby/pivot operations for frequency tables")
doc <- bl(doc, "lifelines.KaplanMeierFitter for the KM figure")
doc <- bl(doc, "multivariate_logrank_test for the p-value annotation")
doc <- nb(doc)
doc <- p(doc, "Every piece of generated code is stored as a string in the code_scripts list — indexed by TFL ID — so it can be executed, saved to disk, reviewed, or sent to a reviewer exactly as a human programmer would write it.")
doc <- nb(doc)
# Step 4
doc <- h2(doc, "Step 4 · Agent 3 — QC / Validation Agent (R/03_qc_agent.R)")
doc <- p(doc, "What it does: This is the quality control layer. It runs two independent implementations of each analysis and compares their numeric outputs cell by cell — the computational equivalent of independent double-programming, a regulatory requirement in clinical trials.")
doc <- nb(doc)
doc <- p(doc, "The process for each analysis:")
doc <- bl(doc, "Execute primary code — runs the Code Generation Agent's R output against the ADaM datasets using eval(parse(text = r_code)) in an isolated environment.")
doc <- bl(doc, "Execute QC code — runs a separate, independently written base-R re-implementation of the same analysis. This is the QC programmer path — deliberately written differently (e.g., tapply instead of dplyr, merge instead of inner_join, table() instead of count()).")
doc <- bl(doc, "Extract numeric values — recursively extracts all numeric cells from both outputs.")
doc <- bl(doc, "Compare cell by cell — applies a numeric tolerance of 0.01. Any difference larger than that is flagged as a discrepancy.")
doc <- bl(doc, "Report status — PASS if zero discrepancies; FAIL if any are found.")
doc <- nb(doc)
doc <- p(doc, "QC Report Result: 4 out of 4 analyses passed with 0 total discrepancies. Only analyses that pass QC flow into the ARS Writer Agent.")
doc <- nb(doc)
# Step 5
doc <- h2(doc, "Step 5 · Agent 4 — ARS Writer Agent (R/04_ars_agent.R)")
doc <- p(doc, "What it does: Encodes each validated TFL as a CDISC Analysis Results Standard (ARS) JSON document — the regulatory-grade provenance record that captures who was analysed, what variable, how, grouped by what, and displayed where.")
doc <- nb(doc)
doc <- p(doc, "Each ARS JSON document contains:")
doc <- bl(doc, "reportingEvent — study ID, version, creation timestamp")
doc <- bl(doc, "analysisSets — population definition with dataset / variable / comparator / value")
doc <- bl(doc, "dataSubsets — record-level filter conditions (if applicable)")
doc <- bl(doc, "analyses — analysis ID, endpoint, population link, grouping, method link")
doc <- bl(doc, "methods — statistical method name and list of operations (COUNT, MEAN, KM, etc.)")
doc <- bl(doc, "outputs — file spec, display title, footnote strings")
doc <- bl(doc, "userSession — generated-by, timestamp, source systems [R, SAS]")
doc <- nb(doc)
doc <- p(doc, "Four ARS JSON files were written: t14_1_1_ars.json, t14_1_2_ars.json, t14_3_1_ars.json, and f14_2_1_ars.json. These are structured for direct ingestion by the TFL Viewer v3.")
doc <- nb(doc)
# Step 6
doc <- h2(doc, "Step 6 · Kaplan-Meier Figure (Produced During Pipeline)")
doc <- p(doc, "As a direct output of the QC agent executing the generated R code, a Kaplan-Meier survival figure was rendered live showing separation between the three treatment arms (Placebo, Active 10mg, Active 20mg), with a log-rank p-value of 3e-04 annotated at the bottom. This confirms the synthetic data has a detectable treatment signal by design.")
doc <- nb(doc)
# Step 7
doc <- h2(doc, "Step 7 · SAS Integration File (sas/tfl_demo.sas)")
doc <- p(doc, "A complete, annotated SAS program was written as the language-parallel implementation. It includes:")
doc <- bl(doc, "Data loading using libname pointing to SAS datasets exported from R via the {haven} package")
doc <- bl(doc, "Table 14.1.1 via PROC FREQ + PROC REPORT")
doc <- bl(doc, "Table 14.1.2 via PROC MEANS + PROC FREQ")
doc <- bl(doc, "Table 14.3.1 via PROC SORT + data step merge + PROC FREQ")
doc <- bl(doc, "Figure 14.2.1 via PROC LIFETEST with ODS GRAPHICS")
doc <- nb(doc)
doc <- p(doc, "Data is moved from R to SAS using: library(haven) then write_sas() for each dataset (adsl, adae, adtte) into the sas/ subdirectory.")
doc <- nb(doc)
# Step 8
doc <- h2(doc, "Step 8 · Abstract (abstract/abstract.qmd)")
doc <- p(doc, "A full Quarto document was created, structured for submission to clinical informatics conferences such as PHUSE US Connect, PharmaSUG, or CDISC Interchange 2026. It contains:")
doc <- bl(doc, "A 250-word structured abstract (Background / Objective / Methods / Results / Conclusion) suitable for direct conference submission.")
doc <- bl(doc, "An extended summary (~800 words) with an architecture diagram, technology stack table, and a demo workflow code block — suitable for a full paper or e-poster.")
doc <- bl(doc, "References to CDISC ARS, pharmaverse, {ellmer}, and the FDA conformance guide.")
doc <- bl(doc, "Placeholders for author name, affiliation, and target conference.")
doc <- nb(doc)
# ── PART 2 ────────────────────────────────────────────────────────────────────
doc <- h1(doc, "PART 2 — Why Plug In a Live LLM, and How To Do It Well")
doc <- nb(doc)
doc <- h2(doc, "Why the Demo Stub Is Not Enough in Practice")
doc <- p(doc, "The demo sap_agent_parse() hard-codes four analysis specifications. In a real clinical trial, this approach breaks down because:")
doc <- bl(doc, "A Phase III SAP is 80 to 200 pages long, covering 50 to 600 distinct analyses.")
doc <- bl(doc, "Analysis specifications are written in natural language by statisticians — not in structured JSON or any machine-readable format.")
doc <- bl(doc, "Specifications are embedded in dense legal and regulatory prose with cross-references, conditional logic (e.g., 'if the primary endpoint is significant, also run...'), and footnotes scattered across sections.")
doc <- bl(doc, "SAP formats change between studies, therapeutic areas, companies, and sponsors. There is no universal template.")
doc <- nb(doc)
doc <- p(doc, "No human programmer can hand-code the equivalent of sap_agent_parse() for every SAP. That is precisely the gap the LLM fills. The LLM does not need to be retrained for each new SAP — it reads and understands natural language natively.")
doc <- nb(doc)
doc <- h2(doc, "What the LLM Actually Does in Agent 1 (SAP Parsing)")
doc <- p(doc, "When use_llm = TRUE, the SAP Parsing Agent sends a structured prompt to the LLM containing four components:")
doc <- bl(doc, "System role: Defines the LLM as a clinical statistical programming expert who understands CDISC, ICH E9, and SAP conventions. This primes the model to interpret regulatory language correctly.")
doc <- bl(doc, "Raw SAP section text: Extracted from a PDF or Word document using tools like {pdftools} or {officer}. The text is passed verbatim — the LLM handles all parsing and interpretation.")
doc <- bl(doc, "Output schema: The exact JSON structure the LLM must return (id, title, population, population_flag, endpoint, dataset, method, display_type, grouping_vars as an array, output_footnotes as an array). This enforces machine-readable output.")
doc <- bl(doc, "Few-shot examples: One or two worked examples showing how a SAP sentence like 'Summary statistics of age will be presented by treatment group for the Safety Population' maps to the structured spec. This dramatically improves consistency.")
doc <- nb(doc)
doc <- p(doc, "The LLM reads the SAP in natural language and returns a machine-readable JSON array. This is not guessing — it is extracting and formalizing structure that the statistician already wrote in prose. The transformation is from human-readable to machine-readable.")
doc <- nb(doc)
doc <- h2(doc, "Why the LLM Adds Value in Agent 2 (Code Generation)")
doc <- p(doc, "The demo Code Generation Agent generates correct R and SAS code from a spec, but only because the demo code is templated for four known analysis types. Real trials include analyses that cannot be templated:")
doc <- bl(doc, "Mixed models for repeated measures (MMRM) — requires PROC MIXED in SAS and {mmrm} in R with specific covariance structure options")
doc <- bl(doc, "Cochran-Mantel-Haenszel tests stratified by centre or baseline severity")
doc <- bl(doc, "Exposure-adjusted incidence rates (events per 100 patient-years)")
doc <- bl(doc, "Shift tables for laboratory grading (CTCAE grade changes from baseline)")
doc <- bl(doc, "Forest plots for pre-specified subgroup analyses")
doc <- bl(doc, "Complex imputation strategies: LOCF, BOCF, multiple imputation via PROC MI")
doc <- nb(doc)
doc <- p(doc, "Each of these has a distinct SAS macro structure and a corresponding R implementation. An LLM trained on millions of lines of statistical code knows these patterns. It can write the correct PROC MIXED or mmrm() call from a method description like 'MMRM with unstructured covariance, REML estimation, treatment by visit interaction' — which is exactly how SAPs are written.")
doc <- nb(doc)
doc <- p(doc, "Critically, the LLM also writes the same analysis in both R and SAS from a single specification. This is what the QC agent needs for independent double-programming — two implementations in different languages, produced from the same source of truth.")
doc <- nb(doc)
doc <- h2(doc, "Why the LLM Adds Value in Agent 3 (QC / Validation)")
doc <- p(doc, "In the demo, the QC independent implementation is hand-coded in base R. This works for four analyses. For a 300-TFL submission it is not feasible. With a live LLM:")
doc <- bl(doc, "Agent 2 generates the primary code in R using {dplyr} / {rtables} style.")
doc <- bl(doc, "Agent 3 sends the same analysis specification to the LLM with a different prompt: 'Write an independent implementation of this analysis in base R / SAS / Python. Do NOT use dplyr or tidyverse. Do NOT look at the primary code.'")
doc <- bl(doc, "The LLM produces a second, stylistically different implementation from scratch.")
doc <- bl(doc, "The QC agent executes both, extracts numeric outputs, and compares cell by cell.")
doc <- nb(doc)
doc <- p(doc, "This is true independent double-programming at scale, fully automated. In a typical Phase III trial, manual double-programming consumes 30 to 40 percent of statistical programming resource. The LLM-driven QC agent reduces that bottleneck from writing code to reviewing output — a fundamentally different and faster activity.")
doc <- nb(doc)
doc <- h2(doc, "How to Enable Live LLM Integration — Full Setup")
doc <- nb(doc)
doc <- h3(doc, "Step 1: Install the package")
doc <- p(doc, "Run in R console: install.packages(\"ellmer\")")
doc <- nb(doc)
doc <- h3(doc, "Step 2: Set your API key securely in .Renviron (never in code)")
doc <- p(doc, "Run: usethis::edit_r_environ()")
doc <- p(doc, "Then add one of the following lines and save the file:")
doc <- p(doc, "    OPENAI_API_KEY=sk-your-key-here")
doc <- p(doc, "    ANTHROPIC_API_KEY=your-key-here")
doc <- p(doc, "Restart R after saving. The key is now available as an environment variable and will never appear in your script or version control.")
doc <- nb(doc)
doc <- h3(doc, "Step 3: Initialize a chat object")
doc <- p(doc, "    library(ellmer)")
doc <- p(doc, "    # OpenAI GPT-4o:")
doc <- p(doc, "    chat <- chat_openai(model = \"gpt-4o\")")
doc <- p(doc, "    # Anthropic Claude 3.5 Sonnet:")
doc <- p(doc, "    chat <- chat_anthropic(model = \"claude-3-5-sonnet-20241022\")")
doc <- nb(doc)
doc <- h3(doc, "Step 4: Replace the stub in sap_agent_parse()")
doc <- p(doc, "The core of the live prompt contains:")
doc <- bl(doc, "System message: 'You are a clinical trial statistical programming expert with deep knowledge of CDISC ADaM, ICH E9, and regulatory submission standards.'")
doc <- bl(doc, "Instruction: 'Parse the following SAP section. Return ONLY a valid JSON array where each element has these keys: id, title, population, population_flag, endpoint, dataset, method, display_type, grouping_vars (array), output_footnotes (array).'")
doc <- bl(doc, "Rules block: population_flag must be a valid ADaM flag variable; dataset must be one of adsl, adae, adlb, adtte; display_type must be exactly Table, Figure, or Listing; return only the JSON array with no prose and no markdown fencing.")
doc <- bl(doc, "The SAP text: pasted directly after the rules block.")
doc <- p(doc, "The LLM response is parsed with jsonlite::fromJSON() and flows directly into the code generation agent.")
doc <- nb(doc)
doc <- h3(doc, "Step 5: Feed it a real SAP section")
doc <- p(doc, "    library(pdftools)")
doc <- p(doc, "    sap_raw <- pdftools::pdf_text(\"path/to/SAP_v2.pdf\")")
doc <- p(doc, "    # Pages 40 to 55 (adjust for your document):")
doc <- p(doc, "    sap_section <- paste(sap_raw[40:55], collapse = \"\\n\")")
doc <- p(doc, "    specs <- sap_agent_parse(sap_text = sap_section, use_llm = TRUE)")
doc <- p(doc, "    sap_specs_to_df(specs)   # inspect what was parsed")
doc <- nb(doc)
doc <- h2(doc, "Why GPT-4o or Claude 3.5 Sonnet Specifically")
doc <- p(doc, "These models are recommended over smaller or cheaper alternatives for four concrete reasons:")
doc <- bl(doc, "Instruction following: The JSON schema must be returned exactly as specified. Missing keys silently break downstream agents. Larger frontier models are far more reliable at strict schema compliance than smaller models.")
doc <- bl(doc, "Domain knowledge: The model must recognize and correctly interpret terms like SAFFL, AEDECOD, PARAMCD, PROC LIFETEST, and ICH E9 without being told what they mean. These are not common internet vocabulary — they are clinical trial standards that frontier models have ingested through training on regulatory documents and programming forums.")
doc <- bl(doc, "Long context window: SAP sections commonly run to 5,000 to 15,000 tokens. Smaller models either truncate silently or hallucinate when context exceeds their window. GPT-4o and Claude 3.5 Sonnet both handle 128K+ token contexts reliably.")
doc <- bl(doc, "Code generation quality: Agent 2 asks the model to write syntactically runnable code in both R and SAS simultaneously. The generated code must use correct PROC options, handle SAS dataset naming conventions (WORK.ADSL), and produce tidyverse-idiomatic R. Frontier models produce code that runs on first attempt at a materially higher rate than smaller models.")
doc <- nb(doc)
doc <- h2(doc, "The Full Vision: What This Unlocks")
doc <- p(doc, "Once the live LLM is connected, the complete end-to-end workflow becomes:")
doc <- nb(doc)
doc <- p(doc, "PDF or Word SAP  -->  LLM extracts structured specs  -->  LLM writes R + SAS code")
doc <- p(doc, "  -->  Code auto-executed against ADaM data  -->  Cell-level QC comparison")
doc <- p(doc, "  -->  CDISC ARS JSON generated  -->  TFL Viewer renders outputs interactively")
doc <- nb(doc)
doc <- p(doc, "A programming team provides the SAP and reviews the output. The framework handles all first-draft programming, quality control, and regulatory metadata in between.")
doc <- nb(doc)
doc <- p(doc, "For a 300-TFL submission, this represents a fundamental change in how statistical programming resource is allocated. The programmer's role shifts from writing and checking code to reviewing and approving it — a shift that can compress programming timelines by weeks and dramatically reduce the risk of human transcription errors in regulatory submissions.")
doc <- nb(doc)
